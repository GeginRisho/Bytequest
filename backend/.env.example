# Server Config
PORT=5000
NODE_ENV=development

# Database Config
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bytequest?schema=public

# Redis Config
REDIS_URL=redis://localhost:6379

# JWT Config
JWT_ACCESS_SECRET=super_secret_access_key_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_12345

# Cloud Storage (Optional)
CLOUDINARY_URL=

# SMTP Config
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
SMTP_FROM=noreply@bytequest.edu

# AI recommendation system flag
USE_LLM_RECOMMENDER=false
